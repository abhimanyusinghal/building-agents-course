# Day 3 needs far less than Day 2: no tracker token, no mailbox.
# One model deployment and a price card, and that is the lot.

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
OPENAI_API_VERSION=2025-04-01-preview

# Your deployment's price card, per 1K tokens. The ledger uses these to turn
# token counts into money.
PRICE_IN_PER_1K=0.0025
PRICE_OUT_PER_1K=0.01
