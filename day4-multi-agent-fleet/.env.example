# Azure OpenAI — the only credentials this folder needs
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=                       # https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=                     # your main chat deployment
AZURE_OPENAI_DEPLOYMENT_FAST=                # small/fast chat deployment (patterns run on this)
AZURE_EMBEDDING_DEPLOYMENT=                  # not used by day 4 — safe to leave blank
OPENAI_API_VERSION=2025-04-01-preview

# price sheet for the run records, $ per 1K tokens (adjust to your models)
PRICE_IN_PER_1K=
PRICE_OUT_PER_1K=
