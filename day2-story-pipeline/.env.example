# ---- the judge (Azure OpenAI) --------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o            # a GPT-4-class deployment with tool calling
OPENAI_API_VERSION=2025-04-01-preview

# ---- the tracker (GitHub, personal account) ------------------------------
GH_REPO=<your-username>/story-pipeline-demo
GH_TOKEN=                                  # fine-grained PAT: Issues RW + Metadata R
GH_TOKEN_READONLY=                         # same repo, Issues READ only — the break device

# ---- the people (Outlook via Microsoft Graph, org account) ---------------
MAIL_CLIENT_ID=                            # Entra app registration (public client)
MAIL_TENANT=<your-tenant>.onmicrosoft.com  # tenant-specific; /common is rejected
REVIEWER_EMAIL=                            # you — approvals and alerts go here

# ---- the dials ------------------------------------------------------------
WATCH_SECONDS=15                           # event-arrival poll interval
STALL_MINUTES=2                            # demo clock; production would be hours
PRICE_IN_PER_1K=0.0025                     # your deployment's price card, per 1K tokens
PRICE_OUT_PER_1K=0.01

# ---- mail fallback (only if the org tenant blocks the Graph app) ----------
MAIL_BACKEND=graph                         # graph | gmail
GMAIL_ADDRESS=                             # used only when MAIL_BACKEND=gmail
GMAIL_APP_PASSWORD=                        # 16-char app password (needs 2-Step Verification)
